# Copy to api/.env. Start from api/ with --spring.profiles.active=local.
# This file is Java properties syntax: no export prefix and no surrounding quotes.
# Escape literal backslashes as \\ in passwords (or use IDE environment variables).
# Copy JDBC host/port from Supabase Connect. Use session pooler 5432 for IPv4.
# Use sslmode=verify-full with the downloaded CA certificate for hosted Supabase.
DB_APP_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/prod-supabase.cer
DB_APP_USERNAME=murise_app.YOUR_PROJECT_REF
DB_APP_PASSWORD=
DB_MIGRATION_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/prod-supabase.cer
DB_MIGRATOR_USERNAME=murise_migrator.YOUR_PROJECT_REF
DB_MIGRATOR_PASSWORD=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
CORS_ORIGINS=http://localhost:3000
PORT=8080
